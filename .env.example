# Copy this file to .env.local and fill in your development project values.
# Only use the Supabase publishable/anon key in the browser. Never put the service-role key here.
# The TMDB API key is also exposed to the browser. Use a non-commercial key and follow TMDB attribution rules.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_TMDB_API_KEY=
